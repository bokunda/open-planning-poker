schema {
  query: Query
  mutation: Mutation
  subscription: Subscription
}

type ApiCollectionOfGamePlayer {
  items: [GamePlayer!]!
  totalCount: Int!
}

type ApiCollectionOfTicket {
  items: [Ticket!]!
  totalCount: Int!
}

type ApiCollectionOfVote {
  items: [Vote!]!
  totalCount: Int!
}

type BaseUserProfile {
  id: UUID!
  userName: String!
}

type ChatMessage {
  id: UUID!
  gameId: UUID!
  playerName: String!
  content: String!
  timestamp: String!
}

type Game {
  settingsDetails: Settings!
  id: UUID!
  name: String!
  description: String!
  """
  Id of the player who runs the game: the creator until the host hands it over.
  The host and co-hosts manage tickets, settings and reveals.
  """
  hostId: UUID!
  "Team room the game belongs to (a sprint of that team), if any."
  teamId: UUID
}

"""
A small "something changed" event. It carries no data that is not already public in the game,
so it is safe to broadcast; clients fetch the details with their own (checked) queries.
"""
type GameChanged {
  gameId: UUID!
  kind: GameChangeKind!
  ticketId: UUID
  playerId: UUID
}

type GamePlayer {
  name: String
  id: UUID!
  "Observers watch the table and do not vote."
  role: PlayerRole!
  "Co-hosts can run the game next to the host."
  isCoHost: Boolean!
}

type GameReport {
  gameId: UUID!
  fileName: String!
  data: [Byte!]!
}

"""
Voting timer of a game, shared by all players. The host starts and stops it.
Clients count down to EndsAt and use ServerTime to correct their clock.
"""
type GameTimer {
  gameId: UUID!
  durationSeconds: Int!
  running: Boolean!
  endsAt: DateTime
  serverTime: DateTime!
}

type Info {
  version: String!
  author: String!
  contact: String!
}

"Base Game Engine mutation."
type Mutation {
  "Sends a chat message to a game. Only players of the game can send messages."
  sendChatMessage(gameId: UUID! content: String!): ChatMessage!
  "Join Game. Requires a valid user token."
  joinGame(gameId: UUID!): Boolean!
  "Leave a Game. Requires a valid user token."
  leaveGame(gameId: UUID!): Boolean!
  """
  Switches between voting (PLAYER) and watching (OBSERVER). Players change their own role;
  the host and co-hosts can change anyone's. Leave playerId empty for yourself.
  """
  setPlayerRole(gameId: UUID! role: PlayerRole! playerId: UUID): Boolean!
  "Makes a player co-host, or a regular player again. Host only."
  setCoHost(gameId: UUID! playerId: UUID! isCoHost: Boolean!): Boolean!
  """
  Removes a player from the game (their votes stay). Host and co-hosts; the host cannot be removed.
  The removed player can join again with the link.
  """
  removePlayer(gameId: UUID! playerId: UUID!): Boolean!
  "Hands the game over to another player in it. Host only; the old host stays as a player."
  transferHost(gameId: UUID! playerId: UUID!): Boolean!
  "Creates a game, returns game details. The caller becomes the game host."
  createGame(name: String! description: String! deckSetup: String teamId: UUID): Game!
  "Deletes a game with its tickets, votes and players. Host only (not co-hosts)."
  deleteGame(gameId: UUID!): Boolean!
  "Generates a PDF report of the game. Only players of the game can generate it."
  generateGameReport(gameId: UUID!): GameReport!
  "Dummy health-check mutation."
  ping: String!
  "Creates Game Settings. Host only."
  createSettings(gameId: UUID! deckSetup: String): Settings!
  "Updates Game Settings. Host only."
  updateSettings(id: UUID! gameId: UUID! deckSetup: String): Settings!
  """
  Room options: auto-reveal, and the async voting window (players vote on all tickets on their own
  until asyncVotingEndsAt; null or a past time switches to meeting mode). Host and co-hosts.
  """
  updateGameOptions(gameId: UUID! autoReveal: Boolean! asyncVotingEndsAt: DateTime): Settings!
  "Creates a team room; the caller becomes its owner and first member."
  createTeam(name: String! description: String): Team!
  "Renames a team room. Owner only."
  updateTeam(teamId: UUID! name: String! description: String): Team!
  "Joins a team room with its link."
  joinTeam(teamId: UUID!): Boolean!
  "Leaves a team room. The owner cannot leave."
  leaveTeam(teamId: UUID!): Boolean!
  "Creates a ticket for given game. Host only."
  createTicket(gameId: UUID! name: String! description: String!): Ticket!
  "Updates a ticket's name and description. Host and co-hosts."
  updateTicket(id: UUID! name: String! description: String!): Ticket!
  "Puts the game's tickets in the given order (first id first). Host and co-hosts."
  reorderTickets(gameId: UUID! ticketIds: [UUID!]!): Boolean!
  """
  Sets the estimate the team agreed on after the reveal (any value, usually a card). An empty value clears it.
  Host and co-hosts.
  """
  setFinalEstimate(ticketId: UUID! value: String): Ticket!
  """
  Re-votes a ticket: deletes its votes, hides voting again and broadcasts it as the
  active ticket to all players in the game. Host only.
  """
  reVoteTicket(gameId: UUID! ticketId: UUID!): Ticket!
  "Deletes a ticket for given game. Host only."
  deleteTicket(id: UUID!): Boolean!
  "Starts (or restarts) the voting timer for everyone in the game. Host only."
  startTimer(gameId: UUID! durationSeconds: Int!): GameTimer!
  "Stops the voting timer for everyone in the game. Host only."
  stopTimer(gameId: UUID!): GameTimer!
  """
  Creates or updates a vote. Only players who joined the game can vote (observers cannot).
  With auto-reveal on, the last missing vote reveals the cards for everyone.
  """
  createOrUpdateVote(ticketId: UUID! value: String!): Vote!
  "Reveals all votes for a ticket and broadcasts them to all players. Host and co-hosts."
  revealVotes(ticketId: UUID!): VotesRevealed!
}

"Base Game Engine query."
type Query {
  """
  Returns recent chat messages for a game (from Redis, 24h TTL). Empty for callers who are not
  players of the game.
  """
  chatMessages(gameId: UUID!): [ChatMessage!]!
  "Returns game with participants"
  gamePlayers(gameId: UUID!): ApiCollectionOfGamePlayer!
  "Returns Game details."
  game(id: UUID!): Game!
  "Returns an info about the Game Engine service."
  info: Info!
  "Dummy health-check query."
  ping: String!
  "Gets Game Settings."
  settings(gameId: UUID!): Settings!
  "A team room by id. Members-only fields are empty for others."
  team(id: UUID!): Team!
  "Team rooms the caller belongs to."
  myTeams: [Team!]!
  "Gets a ticket by id."
  ticket(id: UUID!): Ticket!
  "Gets a list of tickets by gameId."
  tickets(gameId: UUID!): ApiCollectionOfTicket!
  """
  Current voting timer of a game, for players who join while it runs. Null when there is none
  or the caller is not a player of the game.
  """
  gameTimer(gameId: UUID!): GameTimer
  "Gets votes by ticketId."
  votes(ticketId: UUID!): ApiCollectionOfVote!
}

type Settings {
  id: UUID!
  gameId: UUID!
  deckSetup: String!
  "Cards are revealed as soon as every player (not observers) has voted."
  autoReveal: Boolean!
  "End of the async voting window; null when the room is in meeting mode."
  asyncVotingEndsAt: DateTime
}

"One planning session of a team. Points add up the estimates of its revealed tickets."
type Sprint {
  gameId: UUID!
  name: String!
  description: String!
  createdOn: DateTime!
  ticketCount: Int!
  estimatedCount: Int!
  points: Float!
}

type Subscription {
  "New chat messages of a game. Only players of the game can subscribe."
  onChatMessage(gameId: UUID!): ChatMessage!
  onPlayerJoined(gameId: UUID!): BaseUserProfile!
  onPlayerLeave(gameId: UUID!): BaseUserProfile!
  onTicketCreated(gameId: UUID!): Ticket!
  onTicketReVoted(gameId: UUID!): Ticket!
  "Fires when players, tickets or the game itself change; reload the part named by kind."
  onGameChanged(gameId: UUID!): GameChanged!
  "Fires when the host starts or stops the timer."
  onTimerChanged(gameId: UUID!): GameTimer!
  onVoteCreatedOrUpdated(ticketId: UUID!): Vote!
  onVotesRevealed(ticketId: UUID!): VotesRevealed!
}

"""
A persistent team room. Anyone with the link sees its name and can join; members also see
the other members, the sprint history and the velocity.
"""
type Team {
  "True when the caller is a member (or the owner)."
  isMember: Boolean!
  "Members of the team, oldest first. Empty for non-members."
  members: [TeamMember!]!
  "The team's planning sessions, newest first, with their points. Empty for non-members."
  sprints: [Sprint!]!
  """
  Average points of the last three sprints that estimated something; null until there is one.
  A planning aid, not a target.
  """
  averageVelocity: Float
  id: UUID!
  name: String!
  description: String!
  ownerId: UUID!
  createdOn: DateTime!
}

type TeamMember {
  name: String
  id: UUID!
}

type Ticket {
  votes: ApiCollectionOfVote!
  averageVotingValue: Decimal!
  id: UUID!
  gameId: UUID!
  name: String!
  description: String!
  votesRevealed: Boolean!
  "The estimate the host chose after the reveal; null until one is chosen."
  finalEstimate: String
  "Place of the ticket in the game's list (0 first)."
  position: Int!
}

type Vote {
  playerName: String!
  id: UUID!
  playerId: UUID!
  value: String!
}

type VotesRevealed {
  ticketId: UUID!
  revealedBy: String!
  "All votes of the ticket with their values, sent once the host reveals them."
  votes: [Vote!]!
}

"What changed in a game. Clients reload that part (players, tickets or the game and its settings)."
enum GameChangeKind {
  "Host, settings or options changed: reload the game."
  GAME
  "A player joined, left, was removed, or changed role \/ co-host."
  PLAYERS
  "Tickets were edited, deleted, reordered or got a final estimate."
  TICKETS
  "A player was removed; PlayerId says who."
  PLAYER_REMOVED
}

enum PlayerRole {
  PLAYER
  OBSERVER
}

"The `@specifiedBy` directive is used within the type system definition language to provide a URL for specifying the behavior of custom scalar definitions."
directive @specifiedBy("The specifiedBy URL points to a human-readable specification. This field will only read a result for scalar types." url: String!) on SCALAR

"The `Byte` scalar type represents non-fractional whole numeric values. Byte can represent values between 0 and 255."
scalar Byte

"The `DateTime` scalar represents an ISO-8601 compliant date time type."
scalar DateTime @specifiedBy(url: "https:\/\/www.graphql-scalars.com\/date-time")

"The `Decimal` scalar type represents a decimal floating-point number."
scalar Decimal

scalar UUID @specifiedBy(url: "https:\/\/tools.ietf.org\/html\/rfc4122")
