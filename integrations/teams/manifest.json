{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "2.1.0",
  "id": "b11c7c1b-a4ce-4bbf-8218-5a1db223cd8c",
  "developer": {
    "name": "Open Planning Poker",
    "websiteUrl": "https://openplanningpoker.com",
    "privacyUrl": "https://openplanningpoker.com/privacy/",
    "termsOfUseUrl": "https://openplanningpoker.com/terms/"
  },
  "name": { "short": "Open Planning Poker", "full": "Open Planning Poker" },
  "description": {
    "short": "Free planning poker as a tab in your meeting, channel or chat.",
    "full": "Add Open Planning Poker as a tab in a Teams meeting, channel or chat. Start a new game (you become the host) or show a game you already have. Everyone votes from the tab, in the side panel or on the meeting stage. Free and open source, no sign-up."
  },
  "icons": { "color": "color.png", "outline": "outline.png" },
  "accentColor": "#6A3AE8",
  "configurableTabs": [
    {
      "configurationUrl": "https://app.openplanningpoker.com/teams/config",
      "canUpdateConfiguration": true,
      "scopes": ["team", "groupChat"],
      "context": ["channelTab", "privateChatTab", "meetingChatTab", "meetingDetailsTab", "meetingSidePanel", "meetingStage"]
    }
  ],
  "validDomains": ["app.openplanningpoker.com"]
}
