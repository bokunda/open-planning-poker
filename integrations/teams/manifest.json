{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "1.0.0",
  "id": "{{TEAMS_APP_ID}}",
  "developer": {
    "name": "Open Planning Poker",
    "websiteUrl": "https://openplanningpoker.com",
    "privacyUrl": "https://openplanningpoker.com/",
    "termsOfUseUrl": "https://github.com/bokunda/open-planning-poker/blob/main/LICENSE"
  },
  "name": { "short": "Open Planning Poker", "full": "Open Planning Poker" },
  "description": {
    "short": "Start planning poker from a chat or a meeting.",
    "full": "Create a planning poker room from the message extension and share it as a card with a Join button, or add Open Planning Poker as a meeting tab. After each reveal, the ticket and its estimate are posted back to the chat."
  },
  "icons": { "color": "color.png", "outline": "outline.png" },
  "accentColor": "#6A3AE8",
  "bots": [
    {
      "botId": "{{TEAMS_APP_ID}}",
      "scopes": ["team", "groupChat", "personal"],
      "supportsFiles": false,
      "isNotificationOnly": false
    }
  ],
  "composeExtensions": [
    {
      "botId": "{{TEAMS_APP_ID}}",
      "commands": [
        {
          "id": "createGame",
          "type": "action",
          "title": "Start planning poker",
          "description": "Create a room and share it in this chat",
          "context": ["compose", "commandBox"],
          "fetchTask": false,
          "parameters": [
            { "name": "name", "title": "Room name", "description": "For example Sprint 43", "inputType": "text" }
          ]
        }
      ]
    }
  ],
  "configurableTabs": [
    {
      "configurationUrl": "https://ge.openplanningpoker.com/integrations/teams/tab-config",
      "canUpdateConfiguration": true,
      "scopes": ["team", "groupChat"],
      "context": ["meetingSidePanel", "meetingStage", "meetingChatTab", "channelTab", "privateChatTab"]
    }
  ],
  "permissions": ["identity"],
  "validDomains": ["app.openplanningpoker.com", "ge.openplanningpoker.com"]
}
